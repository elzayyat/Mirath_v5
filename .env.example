# ════════════════════════════════════════════════════════════
# MIRATH — Environment Variables
# 1. Copy this file:  cp .env.example .env
# 2. Fill in every required value below
# 3. NEVER commit .env to version control
# ════════════════════════════════════════════════════════════

# ── PostgreSQL ───────────────────────────────────────────────
# Use a strong random password: openssl rand -hex 24
POSTGRES_PASSWORD=your-strong-random-password-here
DATABASE_URL=postgresql://postgres:your-strong-random-password-here@postgres:5432/mirath

# ── JWT (REQUIRED) ───────────────────────────────────────────
# MUST be ≥ 64 chars. Generate with: openssl rand -hex 64
JWT_SECRET=
JWT_ISSUER=mirath-api
JWT_AUDIENCE=mirath-client

# ── Admin Account Seed ───────────────────────────────────────
MIRATH_ADMIN_EMAIL=admin@mirath.app
# Use a strong password (uppercase + lowercase + digit + symbol, ≥ 12 chars)
MIRATH_ADMIN_PASSWORD=

# ── CORS ─────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000

# ── Frontend ─────────────────────────────────────────────────
VITE_API_URL=http://localhost:8080/api
VITE_STANDALONE_MODE=false
# Optional: enable AI features in standalone mode
# VITE_ANTHROPIC_API_KEY=sk-ant-api03-...

# ── External Services (all optional) ─────────────────────────
GOLD_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
STORAGE_PATH=/var/mirath/storage
